{
    "name": "@browsercore/contracts",
    "version": "0.1.1",
    "description": "Shared interfaces, models, and options for the browsercore stack",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "typescript": "^7.0.2"
    }
}
